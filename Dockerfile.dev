FROM node:22-slim

# python3/make/g++ : nécessaires si bcrypt doit être recompilé depuis les
# sources faute de binaire précompilé pour la plateforme de build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "start:dev"]
